@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    // Only the "list" entry should be highlighted as active on the Users section.
    bool isUsersSection = controller == "Users" && action != "Create";
    bool isCreateSection = controller == "Users" && action == "Create";
    string NavClass(bool active) => active ? "sidebar-link is-active" : "sidebar-link";
}
<!DOCTYPE html>
<html lang="vi" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] · Quản lý người dùng</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @* Prevent theme flash: apply stored theme before first paint. *@
    <script>
        (function () {
            try {
                var stored = localStorage.getItem('um-theme');
                var dark = stored ? stored === 'dark'
                    : window.matchMedia('(prefers-color-scheme: dark)').matches;
                document.documentElement.classList.toggle('dark', dark);
            } catch (e) { /* noop */ }
        })();
    </script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="h-full app-shell">
    @* ================= Skip link (keyboard users) ================= *@
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[70]
           focus:rounded-xl focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">
        Chuyển tới nội dung chính
    </a>

    @* ================= Sidebar (mobile overlay) ================= *@
    <div id="sidebarBackdrop" class="backdrop-overlay" aria-hidden="true"></div>

    <aside id="sidebar" class="sidebar" aria-label="Điều hướng chính">
        <div class="sidebar-brand">
            <span class="sidebar-brand-mark" aria-hidden="true">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
            </span>
            <span class="sidebar-brand-text min-w-0">
                <span class="block font-display text-[15px] font-bold text-white leading-tight truncate">User Management</span>
                <span class="block text-[11px] text-ink-400 truncate">Hệ thống quản trị</span>
            </span>
            <button type="button" id="sidebarClose" class="icon-btn lg:hidden ml-auto text-ink-400 hover:text-white hover:bg-white/5"
                    aria-label="Đóng menu">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </div>

        <nav class="flex-1 overflow-y-auto pb-6" aria-label="Menu chính">
            <p class="sidebar-nav-label">Quản lý</p>
            <a asp-controller="Users" asp-action="Index" class="@NavClass(isUsersSection)"
               aria-current="@(isUsersSection ? "page" : null)">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 3v18h18" /><path d="m19 9-5 5-4-4-3 3" />
                </svg>
                <span class="sidebar-link-label">Người dùng</span>
            </a>
            <a asp-controller="Users" asp-action="Create" class="@NavClass(isCreateSection)"
               aria-current="@(isCreateSection ? "page" : null)">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" />
                    <line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" />
                </svg>
                <span class="sidebar-link-label">Thêm người dùng</span>
            </a>

            <p class="sidebar-nav-label">Tài liệu</p>
            <span class="sidebar-link opacity-40 cursor-not-allowed" title="Sắp có" aria-disabled="true">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" /><path d="M9 15h6M9 11h3" />
                </svg>
                <span class="sidebar-link-label">Giấy tờ tùy thân</span>
                <span class="sidebar-soon-badge">Soon</span>
            </span>
        </nav>

        @* Collapse toggle (desktop only) *@
        <div class="hidden lg:block px-3 pb-2">
            <button type="button" id="sidebarCollapse"
                    class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium
                           text-ink-400 hover:text-white hover:bg-white/5 transition-colors duration-150"
                    aria-expanded="true" title="Thu gọn menu" aria-label="Thu gọn menu">
                <svg class="icon w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="m15 18-6-6 6-6" />
                </svg>
                <span class="sidebar-link-label">Thu gọn menu</span>
            </button>
        </div>

        <div class="p-4 mt-auto">
            <div class="rounded-2xl bg-white/5 border border-white/10 p-4">
                <div class="flex items-center gap-2.5">
                    <span class="avatar w-9 h-9 text-xs" aria-hidden="true">AD</span>
                    <div class="sidebar-user-meta min-w-0 flex-1">
                        <p class="text-xs font-semibold text-white truncate">Quản trị viên</p>
                        <p class="text-[11px] text-ink-400 truncate">Nội bộ</p>
                    </div>
                </div>
                <p class="sidebar-user-meta mt-3 text-[10px] leading-relaxed text-ink-500">
                    Chưa có xác thực · chỉ chạy nội bộ
                </p>
            </div>
        </div>
    </aside>

    @* ================= Main ================= *@
    <div class="flex-1 flex flex-col min-w-0">

        <header class="topbar">
            <button type="button" id="sidebarOpen" class="icon-btn lg:hidden" aria-label="Mở menu" aria-controls="sidebar" aria-expanded="false">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
            </button>

            @* Mobile brand — hidden on desktop where the sidebar shows the logo *@
            <a asp-controller="Users" asp-action="Index" class="lg:hidden flex items-center gap-2 min-w-0" aria-label="User Management — trang chủ">
                <span class="grid place-items-center w-8 h-8 rounded-xl bg-brand-gradient text-white shrink-0" aria-hidden="true">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                    </svg>
                </span>
                <span class="font-display text-sm font-bold text-ink-900 dark:text-white truncate">User Management</span>
            </a>

            <div class="min-w-0 flex-1 hidden sm:block">
                <h2 class="font-display text-lg font-bold text-ink-900 dark:text-white truncate">@ViewData["Title"]</h2>
            </div>

            <div class="flex items-center gap-1.5 ml-auto">
                <a asp-controller="Users" asp-action="Index" class="hidden sm:inline-flex btn btn-ghost btn-sm" title="Làm mới dữ liệu">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" /><path d="M21 3v5h-5" />
                        <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" /><path d="M8 16H3v5" />
                    </svg>
                    <span>Làm mới</span>
                </a>

                <button type="button" id="themeToggle" class="icon-btn" aria-label="Đổi giao diện sáng/tối" title="Đổi giao diện" aria-pressed="false">
                    <svg class="icon hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
                    </svg>
                    <svg class="icon block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
                    </svg>
                </button>

                <a asp-controller="Users" asp-action="Create" class="btn btn-primary btn-sm ml-1">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                    <span class="hidden sm:inline">Thêm User</span>
                </a>
            </div>
        </header>

        @* ================= Page content ================= *@
        <main id="main-content" class="flex-1 px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
            <div class="max-w-7xl mx-auto">
                @* Consumed by site.js on DOMContentLoaded, then removed. *@
                @if (TempData["Toast"] is string toast)
                {
                    <div hidden data-toast-autoshow data-variant="success">@toast</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger mb-6" role="alert">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" /><path d="M12 8v4M12 16h.01" />
                        </svg>
                        <p class="flex-1">@error</p>
                    </div>
                }
                @RenderBody()
            </div>
        </main>

        <footer class="border-t border-surface-200 dark:border-ink-800 bg-white dark:bg-ink-900">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-ink-400 dark:text-ink-500">
                <p>&copy; @DateTime.UtcNow.Year · User Management — ASP.NET Core MVC</p>
                <p class="flex items-center gap-1.5">
                    <span class="status-dot bg-emerald-500"></span> Hệ thống hoạt động bình thường
                </p>
            </div>
        </footer>
    </div>

    @* Toast notifications (bottom-right) *@
    <div id="toast-container" class="fixed bottom-4 right-4 z-[55] flex flex-col gap-2.5 w-[calc(100%-2rem)] sm:w-96"
         aria-live="polite" aria-atomic="false"></div>

    @* Modal mount point *@
    <div id="modal-root">
        @await Html.PartialAsync("_ConfirmDeleteModal")
    </div>

    @* jQuery is required by the jquery-validation unobtrusive scripts that the form
       pages load through _ValidationScriptsPartial. Without it those scripts throw
       "jQuery is not defined" and the client-side validation never runs. *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
