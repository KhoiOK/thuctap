@model UserManagement.Web.ViewModels.Users.UserFormViewModel
@{
    ViewData["Title"] = "Chỉnh sửa người dùng";
}

<a asp-action="Index" class="breadcrumb">
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
         stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    Người dùng
</a>

<div class="page-head flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div class="min-w-0">
        <h1 class="page-title text-balance">Chỉnh sửa thông tin</h1>
        <p class="page-subtitle">Cập nhật hồ sơ của người dùng. Các trường có dấu <span class="text-red-500 font-semibold">*</span> là bắt buộc.</p>
    </div>
</div>

<div class="card max-w-4xl">
    <div class="card-body">
        @await Html.PartialAsync("_UserForm", Model)
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
