@model UserManagement.Web.ViewModels.Users.UserDetailViewModel
@{
    ViewData["Title"] = "Chi tiết người dùng";
    var user = Model.User;
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    var initial = string.IsNullOrWhiteSpace(user?.FullName) ? "?" : user.FullName.Trim()[..1].ToUpperInvariant();
}

<a asp-action="Index" asp-route-returnUrl="@Model.ReturnUrl" class="breadcrumb">
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
         stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    Người dùng
</a>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger mb-6" role="alert">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 8v4M12 16h.01" /></svg>
        <p class="flex-1">@Model.ErrorMessage</p>
    </div>
}

@if (user is null)
{
    <div class="card">
        <div class="empty-state">
            <span class="empty-icon">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                     stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" /><path d="m15 15-4.5-4.5M9 9h.01" />
                </svg>
            </span>
            <h2 class="empty-title">Không tìm thấy người dùng</h2>
            <p class="empty-text">Bản ghi có thể đã bị xóa hoặc bạn không có quyền truy cập.</p>
            <a asp-action="Index" class="btn btn-primary mt-6 w-full sm:w-auto">Quay lại danh sách</a>
        </div>
    </div>
    return;
}

@* ================= Hero header ================= *@
<div class="card mb-6 overflow-hidden">
    <div class="h-24 sm:h-28 bg-brand-gradient relative">
        <div class="absolute inset-0 bg-[radial-gradient(60rem_20rem_at_15%_0%,rgba(255,255,255,0.18),transparent_60%)]"></div>
    </div>
    <div class="px-5 sm:px-6 pb-6">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 -mt-10 sm:-mt-12">
            <div class="flex items-end gap-4 min-w-0">
                <span class="avatar w-20 h-20 sm:w-24 sm:h-24 text-2xl sm:text-3xl ring-4 ring-white dark:ring-ink-900 shrink-0" aria-hidden="true">@initial</span>
                <div class="min-w-0 pb-1">
                    <h1 class="font-display text-xl sm:text-2xl lg:text-3xl font-bold text-ink-900 dark:text-white truncate">
                        @user.FullName
                    </h1>
                    <p class="mt-0.5 text-sm text-ink-500 dark:text-ink-400 truncate">@user.Email</p>
                </div>
            </div>

            <div class="flex items-center gap-2 shrink-0">
                <a asp-action="Edit" asp-route-id="@user.Id" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-secondary flex-1 sm:flex-none">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                    Chỉnh sửa
                </a>
                <a href="@Url.Action("Delete", "Users", new { id = user.Id, returnUrl = Model.ReturnUrl })"
                   data-confirm-delete
                   data-confirm-title="Xóa người dùng?"
                   data-confirm-message="Bạn có chắc chắn muốn xóa người dùng &quot;@user.FullName&quot;? Tất cả giấy tờ và ảnh cũng sẽ bị xóa. Hành động này không thể hoàn tác."
                   data-return-url="@Model.ReturnUrl"
                   class="btn btn-danger flex-1 sm:flex-none">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                    Xóa
                </a>
            </div>
        </div>
    </div>
</div>

@* ================= Profile info ================= *@
<section class="card mb-6">
    <div class="card-header">
        <h2 class="card-title flex items-center gap-2">
            <svg class="w-4 h-4 text-brand-600 dark:text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/></svg>
            Thông tin cá nhân
        </h2>
        <a asp-action="Edit" asp-route-id="@user.Id" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-ghost btn-sm">
            Chỉnh sửa
        </a>
    </div>
    <div class="card-body">
        <dl class="detail-grid">
            <div>
                <dt class="detail-label">Email</dt>
                <dd class="detail-value">
                    <a href="mailto:@user.Email" class="link-accent break-all">@user.Email</a>
                </dd>
            </div>
            <div>
                <dt class="detail-label">Số điện thoại</dt>
                <dd class="detail-value tabular-nums">@user.PhoneNumber</dd>
            </div>
            <div>
                <dt class="detail-label">Ngày sinh</dt>
                <dd class="detail-value tabular-nums">
                    @(user.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")
                    @if (user.DateOfBirth is { } dob)
                    {
                        var age = today.Year - dob.Year - (today < dob.AddYears(1) ? 1 : 0);
                        <span class="badge badge-neutral ml-1">@age tuổi</span>
                    }
                </dd>
            </div>
            <div>
                <dt class="detail-label">Giới tính</dt>
                <dd class="detail-value">@Model.GenderDisplay</dd>
            </div>
            <div class="sm:col-span-2">
                <dt class="detail-label">Địa chỉ</dt>
                <dd class="detail-value">
                    @(string.IsNullOrWhiteSpace(user.Address) ? "—" : user.Address)
                </dd>
            </div>
        </dl>

        <div class="divider my-6"></div>

        <dl class="detail-grid">
            <div>
                <dt class="detail-label">Ngày tạo</dt>
                <dd class="detail-value flex items-center gap-2 tabular-nums">
                    <svg class="w-4 h-4 text-ink-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 2" /><circle cx="12" cy="12" r="10"/></svg>
                    @user.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </dd>
            </div>
            <div>
                <dt class="detail-label">Cập nhật lần cuối</dt>
                <dd class="detail-value flex items-center gap-2 tabular-nums">
                    <svg class="w-4 h-4 text-ink-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7L21 8" /><path d="M21 3v5h-5"/></svg>
                    @(user.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa có")
                </dd>
            </div>
        </dl>
    </div>
</section>

@* ================= Identity documents ================= *@
<section class="card">
    <div class="card-header">
        <h2 class="card-title flex items-center gap-2">
            <svg class="w-4 h-4 text-brand-600 dark:text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M9 15h6M9 11h3"/></svg>
            Giấy tờ tùy thân
            <span class="badge badge-neutral">@user.IdentityDocuments.Count</span>
        </h2>
        @if (!Model.HasAllDocumentTypes)
        {
            <a asp-controller="Documents" asp-action="Create" asp-route-userId="@user.Id" asp-route-returnUrl="@Model.ReturnUrl"
               class="btn btn-primary btn-sm">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                     stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                Thêm giấy tờ
            </a>
        }
    </div>

    <div class="card-body">
        @if (user.IdentityDocuments.Count == 0)
        {
            <div class="empty-state !py-14">
                <span class="empty-icon">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M9 15h6M9 11h3"/>
                    </svg>
                </span>
                <h3 class="empty-title">Chưa có giấy tờ tùy thân</h3>
                <p class="empty-text">Thêm CCCD, CMND hoặc Passport để hoàn thiện hồ sơ của người dùng này.</p>
                <a asp-controller="Documents" asp-action="Create" asp-route-userId="@user.Id" asp-route-returnUrl="@Model.ReturnUrl"
                   class="btn btn-primary mt-6 w-full sm:w-auto">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                    Thêm giấy tờ đầu tiên
                </a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                @foreach (var doc in user.IdentityDocuments)
                {
                    var isExpired = doc.ExpiryDate is { } e && e < today;
                    var isExpiringSoon = doc.ExpiryDate is { } e2 && !isExpired && e2 <= today.AddDays(90);
                    var frontProxy = $"/Users/{user.Id}/Documents/{doc.Id}/Image/front";
                    var backProxy = $"/Users/{user.Id}/Documents/{doc.Id}/Image/back";

                    <article class="rounded-2xl border border-surface-200 dark:border-ink-800 bg-surface-50/50 dark:bg-ink-950/40
                                    hover:border-brand-300 dark:hover:border-brand-500/40 hover:shadow-card
                                    transition-all duration-200 overflow-hidden group">
                        <header class="flex items-start justify-between gap-3 px-4 pt-4 pb-3">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <span class="grid place-items-center w-9 h-9 rounded-xl bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-400 shrink-0">
                                    <svg class="w-[1.125rem] h-[1.125rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <rect width="18" height="14" x="3" y="5" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M15 11h3M15 14h3"/>
                                    </svg>
                                </span>
                                <div class="min-w-0">
                                    <h3 class="font-semibold text-sm text-ink-900 dark:text-white truncate">@DocTypeDisplay(doc.DocumentType)</h3>
                                    <p class="text-xs text-ink-500 dark:text-ink-400 tabular-nums truncate">@doc.DocumentNumber</p>
                                </div>
                            </div>
                            @if (isExpired)
                            {
                                <span class="badge badge-danger shrink-0">
                                    <span class="status-dot bg-red-500"></span> Hết hạn
                                </span>
                            }
                            else if (isExpiringSoon)
                            {
                                <span class="badge badge-warning shrink-0">
                                    <span class="status-dot bg-amber-500"></span> Sắp hết hạn
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-success shrink-0">
                                    <span class="status-dot bg-emerald-500"></span> Còn hiệu lực
                                </span>
                            }
                        </header>

                        <dl class="grid grid-cols-2 gap-x-4 gap-y-3 px-4 pb-4">
                            <div>
                                <dt class="detail-label">Ngày cấp</dt>
                                <dd class="text-sm font-medium text-ink-800 dark:text-ink-100 tabular-nums mt-0.5">
                                    @(doc.IssuedDate?.ToString("dd/MM/yyyy") ?? "—")
                                </dd>
                            </div>
                            <div>
                                <dt class="detail-label">Ngày hết hạn</dt>
                                <dd class="text-sm font-medium @(isExpired ? "text-red-600 dark:text-red-400" : "text-ink-800 dark:text-ink-100") tabular-nums mt-0.5">
                                    @(doc.ExpiryDate?.ToString("dd/MM/yyyy") ?? "—")
                                </dd>
                            </div>
                        </dl>

                        @if (!string.IsNullOrEmpty(doc.FrontImageUrl) || (doc.HasBackImage && !string.IsNullOrEmpty(doc.BackImageUrl)))
                        {
                            <div class="flex flex-wrap items-center gap-2 px-4 pb-4">
                                @if (!string.IsNullOrEmpty(doc.FrontImageUrl))
                                {
                                    <button type="button" data-lightbox="@frontProxy" data-lightbox-alt="@DocTypeDisplay(doc.DocumentType) — mặt trước"
                                            class="btn btn-secondary btn-sm">
                                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>
                                        </svg>
                                        Mặt trước
                                    </button>
                                }
                                @if (doc.HasBackImage && !string.IsNullOrEmpty(doc.BackImageUrl))
                                {
                                    <button type="button" data-lightbox="@backProxy" data-lightbox-alt="@DocTypeDisplay(doc.DocumentType) — mặt sau"
                                            class="btn btn-secondary btn-sm">
                                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>
                                        </svg>
                                        Mặt sau
                                    </button>
                                }
                            </div>
                        }

                        <footer class="flex items-center justify-end gap-1 px-3 py-2.5 border-t border-surface-200 dark:border-ink-800 bg-white/60 dark:bg-ink-900/40">
                            <a asp-controller="Documents" asp-action="Edit" asp-route-userId="@user.Id" asp-route-documentId="@doc.Id" asp-route-returnUrl="@Model.ReturnUrl"
                               class="icon-btn w-9 h-9" title="Chỉnh sửa giấy tờ" aria-label="Chỉnh sửa @DocTypeDisplay(doc.DocumentType)">
                                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                            </a>
                            <a href="@Url.Action("Delete", "Documents", new { userId = user.Id, documentId = doc.Id, returnUrl = Model.ReturnUrl })"
                               data-confirm-delete
                               data-confirm-title="Xóa giấy tờ?"
                               data-confirm-message="Bạn có chắc chắn muốn xóa giấy tờ &quot;@DocTypeDisplay(doc.DocumentType)&quot; của &quot;@user.FullName&quot;?"
                               data-return-url="@Model.ReturnUrl"
                               class="icon-btn w-9 h-9 text-red-600 hover:bg-red-50 hover:text-red-700 dark:text-red-400 dark:hover:bg-red-500/10"
                               title="Xóa giấy tờ" aria-label="Xóa @DocTypeDisplay(doc.DocumentType)">
                                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                            </a>
                        </footer>
                    </article>
                }
            </div>
        }
    </div>
</section>

@functions {
    string DocTypeDisplay(string type) => type switch
    {
        "cccd" => "CCCD",
        "cmnd" => "CMND",
        "passport" => "Passport",
        _ => type
    };
}
