<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.2.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <!--
      Microsoft.Data.SqlClient 6.1.1 kéo theo System.Security.Cryptography.Pkcs 9.0.4,
      có lỗ hổng đã biết (GHSA-846f-f764-76mx, mức high). PackageReference trực tiếp
      ở đây ghim phiên bản đã vá, đè lên phiên bản transitive.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.23" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Local development secrets (Cloudinary credentials, ...). The Web SDK's default
      glob excludes *.local.json, so it has to be copied explicitly.
      This file is listed in .gitignore and must never be committed.
    -->
    <Content Update="appsettings.*.local.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
