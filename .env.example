# =============================================================================
#  User Management — Environment Variables Template
# =============================================================================
#  Copy file này thành `.env` (được .gitignore bỏ qua) và điền giá trị thật.
#
#  Trong ASP.NET Core, biến môi trường dùng dấu `__` thay cho `:`.
#  Ví dụ: `Cloudinary:ApiSecret`  →  `Cloudinary__ApiSecret`
#
#  Windows PowerShell:
#    $env:Cloudinary__ApiSecret = "your-secret"
#  Linux/macOS (.env + docker-compose):
#    Cloudinary__ApiSecret=your-secret
# =============================================================================

# -----------------------------------------------------------------------------
#  Cloudinary — lưu trữ ảnh giấy tờ
#  Lấy tại: https://console.cloudinary.com/settings/api-keys
# -----------------------------------------------------------------------------
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

# Thư mục gốc trong tài khoản Cloudinary (mặc định: user-management)
Cloudinary__Folder=user-management

# true → delivery type "authenticated" (ảnh không public, BR-17)
Cloudinary__UseSecureDelivery=true

# true → xoá/xoay asset cũng invalidate CDN cache (BR-16)
Cloudinary__AutoInvalidate=true

# -----------------------------------------------------------------------------
#  PaddleOCR service — quét thông tin giấy tờ
#  Mặc định chạy qua docker-compose tại http://localhost:8100
# -----------------------------------------------------------------------------
Ocr__Enabled=true
Ocr__BaseUrl=http://localhost:8100
Ocr__TimeoutSeconds=30

# Ngưỡng confidence tối thiểu để auto-fill (BR-14)
Ocr__MinConfidence=0.6

# Ngưỡng badge "confidence cao"
Ocr__HighConfidence=0.85

# Cho phép năm 2 chữ số (20/04/95 → 1995-04-20), luôn gắn cờ "cần kiểm tra"
Ocr__AllowTwoDigitYearInference=true

# -----------------------------------------------------------------------------
#  Database (production)
# -----------------------------------------------------------------------------
# ConnectionStrings__Default=Server=localhost;Database=UserManagementDb;User Id=sa;Password=<your-password>;TrustServerCertificate=True
